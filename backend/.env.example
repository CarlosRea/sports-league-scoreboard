# Database connection string (defaults to local SQLite database)
# Supported engines: SQLite, PostgreSQL, MySQL, etc.
# Examples:
#   SQLite: sqlite:///./scoreboard.db
#   PostgreSQL (Local / Docker Compose): postgresql://sdip:sdip@localhost:5434/sdip
#   PostgreSQL (Production): postgresql://user:password@db-host:5432/scoreboard_db
DATABASE_URL=sqlite:///./scoreboard.db

# JWT Secret Key for token authentication (ephemeral random generated if unset)
JWT_SECRET_KEY=
