# ==============================================================================
# Sports League Scoreboard - Production Environment Configuration
# ==============================================================================
# Copy this file to .env.prod for local overrides when running the production stack.

ENVIRONMENT=production
NODE_ENV=production

# ------------------------------------------------------------------------------
# Production Application Settings
# ------------------------------------------------------------------------------
# Host port mapping for production web application (http://localhost:8010)
APP_PORT=8010
PORT=8009
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Production PostgreSQL Database
# ------------------------------------------------------------------------------
# Host port mapping for production PostgreSQL (localhost:5435)
POSTGRES_PORT=5435
POSTGRES_USER=scoreboard_prod_user
POSTGRES_PASSWORD=scoreboard_prod_secure_password_2026!
POSTGRES_DB=scoreboard_prod

# Application Database URLs (Internal container networking)
DATABASE_URL=postgresql://scoreboard_prod_user:scoreboard_prod_secure_password_2026!@postgres:5432/scoreboard_prod
SDIP_DATABASE_URL=postgresql://scoreboard_prod_user:scoreboard_prod_secure_password_2026!@postgres:5432/scoreboard_prod

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Production JWT Secret Key (Set a cryptographically strong 256-bit secret)
JWT_SECRET_KEY=prod_jwt_secret_scoreboard_super_secure_vault_token_2026

# ------------------------------------------------------------------------------
# OpenTelemetry Telemetry Settings
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME=sports-league-scoreboard
SERVICE_NAME=sports-league-scoreboard
DEPLOYED_VERSION=0.1.0
OTEL_SERVICE_VERSION=0.1.0
# Optional OTLP Exporter Endpoint (e.g. http://localhost:4318/v1/traces)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
