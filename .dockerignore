# Version control
.git
.gitignore

# Dependencies & Environments
**/.venv
**/node_modules
**/__pycache__
**/*.py[cod]
**/*$py.class

# Test & Caches
**/.pytest_cache
**/.ruff_cache
**/.coverage
**/htmlcov

# Build artifacts
**/dist
**/build
**/dist-ssr

# Environment files & Databases
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
**/*.db
**/*.sqlite
**/*.sqlite3

# Logs
**/logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*

