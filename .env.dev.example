# ==============================================================================
# Sports League Scoreboard - Development Environment Configuration
# ==============================================================================
# Copy this file to .env.dev for local overrides when running the development stack.

ENVIRONMENT=development
NODE_ENV=development

# ------------------------------------------------------------------------------
# Development Application Settings
# ------------------------------------------------------------------------------
# Host port mapping for development web application (http://localhost:8009)
APP_PORT=8009
PORT=8009
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Development PostgreSQL Database
# ------------------------------------------------------------------------------
# Host port mapping for development PostgreSQL (localhost:5434)
POSTGRES_PORT=5434
POSTGRES_USER=sdip
POSTGRES_PASSWORD=sdip
POSTGRES_DB=sdip

# Application Database URLs (Internal container networking)
DATABASE_URL=postgresql://sdip:sdip@postgres:5432/sdip
SDIP_DATABASE_URL=postgresql://sdip:sdip@postgres:5432/sdip

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=dev_jwt_secret_sports_scoreboard_2026
